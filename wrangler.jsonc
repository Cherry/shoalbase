{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "shoalbase",
	"compatibility_date": "2026-08-01",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"preview_urls": true,
	// PMA_COOKIE_SECRET and PMA_SERVERS are set with `npx wrangler secret put`; see README.md.
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist",
		"not_found_handling": "404-page"
	}
}
